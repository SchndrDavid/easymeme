# Private deployment notes, not part of the project
FOREMAN-REPO-TEMPLATE.txt

.env
__pycache__/
*.pyc
venv/
.venv/

# Runtime sticker library. The directory itself is tracked (data/stickers/.gitkeep)
# so the compose bind mount has an existing, checkout-owned target rather than one
# Docker creates as root; only the stickers themselves are ignored.
data/stickers/*
!data/stickers/.gitkeep
