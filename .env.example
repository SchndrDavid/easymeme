# Host port the app is published on. Change it only if it clashes with
# another service on the same host.
EASYMEME_PORT=8104

# UID/GID the container process runs as. Match them to the host user that
# owns the deployment directory.
EASYMEME_UID=1000
EASYMEME_GID=1000

# Set to 1 to lock the sticker library: it can still be browsed and used, but
# no sticker can be added or deleted. Leave unset for a normal read-write setup.
EASYMEME_STICKERS_RO=
